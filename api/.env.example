# ─────────────────────────────────────────────────────────────────────────────
# POSM Field-Execution Platform — backend environment (chassis)
# Copy to .env for local development. NEVER commit a real .env.
# ─────────────────────────────────────────────────────────────────────────────

# Postgres — the POSM database on the shared instance. `prisma generate`/`build`/
# `tsc` do NOT need this; runtime + `prisma migrate` do.
DATABASE_URL="postgresql://posm_user:posm_pass@localhost:5432/posm_dev?schema=public"

# JWT signing secret — REQUIRED at boot (JwtStrategy refuses to start without it).
JWT_SECRET="dev-only-change-me"
# Access-token lifetime. Defaults to 60m in code (short, so the rolling session rolls).
JWT_EXPIRES_IN="60m"

# ── OTP (dev/staging convenience) ────────────────────────────────────────────
# When set (and allowed — non-prod NODE_ENV or ALLOW_FIXED_OTP on staging), every
# OTP is this constant and MSG91 is not called.
FIXED_OTP="123456"
# Staging opt-in for FIXED_OTP while NODE_ENV=production (never set on real prod).
# ALLOW_FIXED_OTP="true"

# ── MSG91 (OTP / SMS / WhatsApp / SMTP email) ────────────────────────────────
MSG91_AUTH_KEY=""
MSG91_OTP_TEMPLATE_ID=""
MSG91_WHATSAPP_NUMBER=""
# SMTP relay for transactional email (reports). Host/port/user default to MSG91's relay.
MSG91_SMTP_PASS=""
MSG91_SMTP_HOST="smtp.mailer91.com"
MSG91_SMTP_PORT="587"
MSG91_SMTP_USER=""
REPORTS_FROM_EMAIL=""

# ── Google Cloud Storage (media: recce/install photos) ───────────────────────
GCS_BUCKET="posm-platform-files"
GCP_PROJECT_ID=""
# Local dev only — path to a service-account key JSON with GCS access.
# GOOGLE_APPLICATION_CREDENTIALS="/path/to/dev-sa-key.json"

# ── HTTP server ──────────────────────────────────────────────────────────────
PORT="4000"
# Comma-separated allowed CORS origins (the Next.js PWA).
CORS_ORIGINS="http://localhost:3000"

# ── RBAC enforcement (fine-grained @RequirePermission master switch) ─────────
# Off by default → PermissionGuard is a no-op unless a route carries @RequirePermission
# AND this is 'true' AND the tenant opts in via features.rbacEnforcement.
RBAC_ENFORCEMENT="false"

# Log level (pino). Defaults: info in prod, debug otherwise.
# LOG_LEVEL="debug"
NODE_ENV="development"
