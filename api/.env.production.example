# ─────────────────────────────────────────────────────────────────────────────
# gifsy-posm API — PRODUCTION environment (Cloud Run service `posm-api-prod`)
#
# PLACEHOLDERS ONLY. This file documents the shape of the env; it is NOT loaded by the
# container. In Cloud Run the values are injected as service env vars:
#   [secret] = bound from Secret Manager (`--set-secrets`)   → never put the real value in git
#   [plain]  = ordinary env var (`--set-env-vars`, via Terraform)
# NEVER commit a real .env / .env.production. Canonical inventory: docs/plans/DEPLOY-ENV-VARS.md
# ─────────────────────────────────────────────────────────────────────────────

# ── Runtime mode ─────────────────────────────────────────────────────────────
# [plain] Required. api/src/main.ts also refuses to boot in production without DATABASE_URL + JWT_SECRET.
NODE_ENV=production
# [plain, injected by Cloud Run] Do not set by hand on Cloud Run (default 8080). main.ts reads it.
# PORT=8080

# ── Database ─────────────────────────────────────────────────────────────────
# [secret] Secret Manager: `posm-prod-database-url`. Shape only — real value holds the
# `posm_app` password. Database MUST be named `posm_prod` (fixed-otp.ts also hard-refuses any
# URL matching /posm_prod as defense-in-depth).
#   Unix-socket form (Cloud SQL connector / --add-cloudsql-instances):
#     postgresql://posm_app:<PASSWORD>@localhost/posm_prod?host=/cloudsql/<PROJECT_ID>:asia-south1:<SQL_INSTANCE>&schema=public
#   Private-IP / Direct VPC egress form:
#     postgresql://posm_app:<PASSWORD>@<PRIVATE_IP>:5432/posm_prod?schema=public
DATABASE_URL="postgresql://posm_app:<PASSWORD>@<PRIVATE_IP>:5432/posm_prod?schema=public"

# ── Auth ─────────────────────────────────────────────────────────────────────
# [secret] Secret Manager: `posm-prod-jwt-secret`. REQUIRED at boot. MUST be IDENTICAL to the prod
# frontend's JWT_SECRET (the Next proxy verifies tokens). Use a distinct value from staging.
JWT_SECRET="<from Secret Manager: posm-prod-jwt-secret>"
# [plain] Access-token lifetime (short, so the rolling session slides).
JWT_EXPIRES_IN=60m

# ── OTP ──────────────────────────────────────────────────────────────────────
# ⛔ PRODUCTION sets NEITHER `FIXED_OTP` NOR `ALLOW_FIXED_OTP`. Do not add them.
# The fixed-OTP guard (api/src/common/fixed-otp.ts) FAILS CLOSED: with NODE_ENV=production and no
# explicit opt-in + staging DB match, the 123456 bypass is denied, and real MSG91 OTPs are sent.

# ── MSG91 (SMS / OTP / WhatsApp / SMTP email) ────────────────────────────────
# [secret] `posm-prod-msg91-auth-key`
MSG91_AUTH_KEY="<from Secret Manager: posm-prod-msg91-auth-key>"
# [secret] `posm-prod-msg91-otp-template-id`
MSG91_OTP_TEMPLATE_ID="<from Secret Manager: posm-prod-msg91-otp-template-id>"
# [plain, optional] WhatsApp integrated number — WhatsApp sends are skipped (logged) if unset.
MSG91_WHATSAPP_NUMBER=""
# [secret] SMTP relay credentials: `posm-prod-msg91-smtp-user` / `posm-prod-msg91-smtp-pass`
MSG91_SMTP_USER="<from Secret Manager: posm-prod-msg91-smtp-user>"
MSG91_SMTP_PASS="<from Secret Manager: posm-prod-msg91-smtp-pass>"
# [plain] SMTP host/port (MSG91 mailer relay).
MSG91_SMTP_HOST=smtp.mailer91.com
MSG91_SMTP_PORT=587
# [plain] From-address for scheduled/transactional reports (must be a MSG91-verified sender).
REPORTS_FROM_EMAIL="<reports@your-verified-domain>"

# ── Media storage (Google Cloud Storage) ─────────────────────────────────────
# [plain] `gcs` in cloud (`local` is dev/compose only).
STORAGE_DRIVER=gcs
# [plain] Prod media bucket (runtime SA `posm-api-prod` has storage.objectAdmin on it).
GCS_BUCKET=posm-prod-files
# [plain] GCP project id (TF var `project_id`). Auth is via the Cloud Run runtime SA (ADC) —
# do NOT set GOOGLE_APPLICATION_CREDENTIALS in cloud.
GCP_PROJECT_ID="<PROJECT_ID>"

# ── HTTP ─────────────────────────────────────────────────────────────────────
# [plain] Comma-separated allowed browser origins = the prod frontend URL(s). No trailing slash.
# (Browser calls are same-origin via the Next proxy, so this is mostly defense-in-depth.)
CORS_ORIGINS="https://<posm-frontend-prod URL or custom domain>"

# ── Misc ─────────────────────────────────────────────────────────────────────
# [plain] Kept per the deploy contract. NOTE: current code no longer reads this (PermissionGuard
# always enforces RBAC) — it is a harmless no-op, carried for contract/inventory parity.
RBAC_ENFORCEMENT=false
# [plain] pino level.
LOG_LEVEL=info
