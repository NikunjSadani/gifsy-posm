// ─────────────────────────────────────────────────────────────────────────────
// POSM Field-Execution Platform — Prisma schema  (v0 · FIRST CUT for review)
//
// Standalone multi-tenant product on the shared Gifsy chassis. Postgres on the
// shared instance (own `posm` database). Chassis models (Client/User/Session/
// AuditLog) are adapted from Loyaltybaseclaude; POSM domain models are new.
//
// Design rationale + reuse map: docs/plans/POSM-BUILD-PLAN.md
// Anti-fraud posture: geo-fence + accuracy caps + dup-hash + before≠after
//   (PWA-achievable; NO OS mock-provider flag — matches the platform pattern).
//
// ⚠️ v0 — the two domain modelling calls to confirm before we build on this:
//   (1) Pipeline unit = site-level Recce/Installation submissions with per-POSM
//       child rows (chosen here), vs a flat per-POSM "unit" row. See notes below.
//   (2) Vendor field logins = `User` rows (role VENDOR_FIELD + vendorId) reusing
//       the chassis auth, vs a separate identity table. `User.vendorId` chosen.
// ─────────────────────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Prisma 7 no longer accepts an inline `url` here — the connection URL lives in
  // prisma.config.ts (for Migrate) and is supplied to PrismaClient via the pg adapter
  // (prisma/prisma.service.ts). Data model below is UNCHANGED.
}

// ═════════════════════════════════════════════════════════════════════════════
// CHASSIS — adapted from loyalty (copy the code; strip loyalty-specific fields)
// ═════════════════════════════════════════════════════════════════════════════

/// A tenant. One deploy serves many (Kwality + future POSM clients).
model Client {
  id        String   @id @default(cuid())
  slug      String   @unique // e.g. "kwality"
  name      String
  features  Json     @default("{}") // per-tenant flags (posmEnabled, nearbyOutletsEnabled, …)
  branding  Json     @default("{}") // primaryColor etc. → CSS vars (chassis pattern)
  settings  Json     @default("{}") // PosmConfig lives here (settings-backed, like VisibilityConfig)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users     User[]
  vendors   Vendor[]
  sites     Site[]
  posmTypes PosmType[]
  // Opposite relation fields required by Prisma for Recce.client / Installation.client
  // (the relations already exist on those models; these are the mandatory back-references).
  recces    Recce[]
  installs  Installation[]

  @@map("clients")
}

enum UserRole {
  GIFSY_ADMIN // platform operator (cross-tenant)
  CLIENT_ADMIN // the brand's admin (Kwality HO)
  ASM // approves recces
  AUDITOR // audits installations
  VENDOR_HO // vendor head-office (read-only over its fleet)
  VENDOR_FIELD // the 7–10 on-ground login IDs
}

/// Every human login. Vendor field IDs are User rows with role VENDOR_FIELD +
/// vendorId set — the chassis JwtPayload already carries an optional vendorId,
/// so vendor-fleet scoping rides the existing RBAC (blueprint: express in chassis).
model User {
  id                    String    @id @default(cuid())
  clientId              String
  // Login identity is EMAIL + password (owner decision 2026-10-01; replaced phone+OTP). `email` is
  // unique per tenant and REQUIRED to log in; `passwordHash` null ⇒ login disabled until an admin
  // sets a password. `phone` is now an OPTIONAL contact field (notifications), no longer the login id.
  email                 String?
  passwordHash          String?
  // Brute-force lockout: N consecutive failures locks the account until `lockedUntil`.
  failedLoginAttempts   Int       @default(0)
  lockedUntil           DateTime?
  phone                 String?
  name                  String
  role                  UserRole
  vendorId              String? // set for VENDOR_FIELD / VENDOR_HO
  promoterCode          String? // field-user promoter/employee code (report ID column); owner-supplied
  isActive              Boolean   @default(true)
  // Session kill-switch authority (chassis auth pattern, ported from loyalty). When a
  // "log out everywhere" / deactivation / refresh-reuse stamps this to `now`, every session
  // whose createdAt predates it is treated as dead by refreshToken + jwt.strategy — so a
  // racing refresh cannot outlive logout-all. Nullable: no stamp ⇒ no invalidation.
  sessionsInvalidBefore DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  client   Client        @relation(fields: [clientId], references: [id])
  vendor   Vendor?       @relation(fields: [vendorId], references: [id])
  sessions UserSession[]

  // reverse relations for actor stamps
  asmSites           Site[]         @relation("SiteAsm")
  approvedRecces     Recce[]        @relation("RecceApprover")
  submittedRecces    Recce[]        @relation("RecceSubmitter")
  auditedInstalls    Installation[] @relation("InstallAuditor")
  submittedInstalls  Installation[] @relation("InstallSubmitter")
  hoReviewedInstalls Installation[] @relation("InstallHoReviewer")
  hoReviewedRecces   Recce[]        @relation("RecceHoReviewer")

  // Email is the login id — unique per tenant when set (Postgres NULLs are distinct, so pre-email
  // rows don't collide; a user can't log in until an admin assigns an email + password).
  @@unique([clientId, email])
  @@unique([clientId, phone]) // phone kept unique per tenant (now optional contact)
  // Promoter code is unique per tenant when set. Postgres treats NULLs as distinct, so the many
  // existing users with a null code do not collide — only a duplicate non-null code is rejected.
  @@unique([clientId, promoterCode])
  @@index([clientId, role])
  @@index([vendorId])
  @@map("users")
}

/// Rolling 7-day session with single-use refresh rotation (chassis auth pattern).
model UserSession {
  id               String    @id @default(cuid())
  userId           String
  refreshTokenHash String    @unique
  rotatedFromId    String?
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())
  lastSeenAt       DateTime  @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("user_sessions")
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  APPROVE
  REJECT
  EXPORT
  IMPORT
}

/// Immutable, append-only audit trail (chassis pattern — add a thin
/// AuditService.write() wrapper rather than 44 inline call-sites).
model AuditLog {
  id         String      @id @default(cuid())
  actorId    String?
  action     AuditAction
  entityType String
  entityId   String
  oldValues  Json?
  newValues  Json?
  ipAddress  String?
  userAgent  String?
  metadata   Json?
  createdAt  DateTime    @default(now())

  @@index([entityType, entityId])
  @@index([actorId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

// OTP login was removed on 2026-10-01 (owner decision) in favour of email + password. The former
// OtpCode model + OtpPurpose/OtpChannel enums were deleted here; the `otp_codes` table + enums are
// dropped by the accompanying migration. MSG91 remains for transactional email (reports).

// ═════════════════════════════════════════════════════════════════════════════
// POSM MASTERS
// ═════════════════════════════════════════════════════════════════════════════

model Vendor {
  id        String   @id @default(cuid())
  clientId  String
  code      String
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  client Client @relation(fields: [clientId], references: [id])
  users  User[]
  sites  Site[]

  @@unique([clientId, code])
  @@map("vendors")
}

enum SiteStatus {
  ACTIVE
  INACTIVE
}

/// First-class site master with its OWN authoritative geo (POSM does not
/// bootstrap the fence reference off a KYC board-photo like loyalty does).
model Site {
  id        String     @id @default(cuid())
  clientId  String
  code      String
  name      String
  phone     String?
  lat       Decimal?   @db.Decimal(10, 8) // authoritative reference for the geo-fence
  lng       Decimal?   @db.Decimal(11, 8)
  town      String?
  rsCode    String? // "RS" filter dimension from the brief
  // Outlet-master geography/classification (added for the Outlet Execution Report). All
  // nullable + populated from the outlet upload / create-edit form; report columns.
  region    String?
  state     String?
  cluster   String?
  beatName  String?
  channel   String? // trade channel (e.g. GT / MT / …)
  address   String?
  vendorId  String? // the vendor whose fleet services this site
  asmUserId String? // approving ASM
  status    SiteStatus @default(ACTIVE)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  client   Client         @relation(fields: [clientId], references: [id])
  vendor   Vendor?        @relation(fields: [vendorId], references: [id])
  asm      User?          @relation("SiteAsm", fields: [asmUserId], references: [id])
  recces   Recce[]
  installs Installation[]

  @@unique([clientId, code])
  @@index([clientId, vendorId])
  @@index([clientId, asmUserId])
  @@index([clientId, town])
  @@map("sites")
}

model PosmType {
  id                String  @id @default(cuid())
  clientId          String
  code              String
  name              String
  defaultDimensions Json? // {width,height,unit} template
  imageKey          String? // reference photo (posm-media/<clientId>/… key) for the field catalogue
  isActive          Boolean @default(true)

  client     Client      @relation(fields: [clientId], references: [id])
  reccePosms ReccePosm[]

  @@unique([clientId, code])
  @@map("posm_types")
}

// ═════════════════════════════════════════════════════════════════════════════
// PIPELINE — recce → ASM approval → installation → audit
//   Site-level submissions (Recce / Installation) with per-POSM child rows.
//   Max 2 POSM per site is enforced in service logic + a partial constraint.
// ═════════════════════════════════════════════════════════════════════════════

enum RecceStatus {
  SUBMITTED
  APPROVED // ASM approved → unlocks installation
  REJECTED
}

/// How a recce was captured.
///   APP    — the standard in-app recce against a pre-existing outlet (RS/Beat picked). One per outlet.
///   MANUAL — field exec typed the outlet details inline (outlet may be off-master); skips ASM, goes
///            straight to HO. UNLIMITED per outlet (different elements installed at different times).
enum RecceMode {
  APP
  MANUAL
}

enum InstallationStatus {
  SUBMITTED
  AUDIT_APPROVED
  AUDIT_REJECTED
}

/// HO/Admin escalation outcome for an installation. Orthogonal to InstallationStatus: it is only
/// meaningful AFTER the auditor rejects (AUDIT_REJECTED), at which point the row escalates to HO.
/// The auditor's AUDIT_REJECTED is never rewritten — the report shows Audit Status and HO Approval
/// Status independently (owner decision 2026-09-30).
///   NONE     — not escalated (auditor approved, or not yet audited)
///   PENDING  — auditor rejected → awaiting HO/Admin review
///   APPROVED — HO overruled the audit reject → final approved
///   REJECTED — HO upheld the reject → terminal rejected
enum HoReviewStatus {
  NONE
  PENDING
  APPROVED
  REJECTED
}

/// Controlled reject-reason vocabulary (chassis reject-code pattern). Used by
/// both the ASM (recce) and the auditor (installation) stages.
enum RejectReasonCode {
  BLURRY
  WRONG_SITE
  POSM_NOT_VISIBLE
  GEO_MISMATCH
  DUPLICATE_PHOTO
  WRONG_POSM
  DIMENSIONS_MISMATCH
  OTHER
}

/// One live recce per site (recapture on reject bumps `version`).
model Recce {
  id            String      @id @default(cuid())
  clientId      String
  siteId        String
  submittedById String // VENDOR_FIELD user
  status        RecceStatus @default(SUBMITTED)
  recceMode     RecceMode   @default(APP) // APP = one per outlet; MANUAL = unlimited, skips ASM → HO
  version       Int         @default(1)

  // geo (worst/representative fixed photo — same math as loyalty geo-fence)
  captureLat      Decimal? @db.Decimal(10, 8)
  captureLng      Decimal? @db.Decimal(11, 8)
  captureAccuracy Int?
  distanceMeters  Decimal? @db.Decimal(10, 2)
  geoFenceOk      Boolean? // null = unverifiable (flag, not block)

  capturedAt DateTime? // client shutter time
  receivedAt DateTime  @default(now()) // server time (clock-skew guard)

  approvedById        String? // ASM
  reviewedAt          DateTime?
  rejectionReasonCode RejectReasonCode?
  rejectionReason     String?

  // HO (CLIENT_ADMIN / GIFSY_ADMIN) approval gate — a NEW stage AFTER ASM approve, BEFORE install.
  // ASM approve sets hoReviewStatus=PENDING; HO approve → APPROVED (unlocks install); HO reject →
  // status=REJECTED (back to recce). Mirrors the Installation HO fields; uses the SAME reason codes.
  hoReviewStatus        HoReviewStatus    @default(NONE)
  hoReviewedById        String? // CLIENT_ADMIN / GIFSY_ADMIN
  hoReviewedAt          DateTime?
  hoRejectionReasonCode RejectReasonCode?
  hoRejectionReason     String?

  // Last time a "pending ASM approval" reminder email that INCLUDED this recce was sent — the
  // per-recce ledger that throttles the threshold-triggered ASM reminder (reports feature).
  lastRemindedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  client       Client        @relation(fields: [clientId], references: [id])
  site         Site          @relation(fields: [siteId], references: [id], onDelete: Cascade)
  submittedBy  User          @relation("RecceSubmitter", fields: [submittedById], references: [id])
  approvedBy   User?         @relation("RecceApprover", fields: [approvedById], references: [id])
  hoReviewedBy User?         @relation("RecceHoReviewer", fields: [hoReviewedById], references: [id])
  posms        ReccePosm[]
  installation Installation?

  // One live APP recce per outlet; MANUAL recces are unlimited. Prisma can't express a partial
  // unique, so APP-only uniqueness is enforced by the raw partial index `recces_app_one_per_site`
  // (WHERE "recceMode" = 'APP') created in migration `add_manual_recce`. This plain index covers
  // the (clientId, siteId) lookups that remain.
  @@index([clientId, siteId])
  @@index([clientId, status])
  @@index([clientId, hoReviewStatus])
  @@map("recces")
}

/// A single POSM planned at a site during recce (max 2 per recce).
model ReccePosm {
  id           String @id @default(cuid())
  recceId      String
  slotNo       Int // 1 or 2
  posmTypeId   String
  dimensions   Json // {width,height,unit} entered by the rep (numeric)
  photo        Json // MediaValue {key, geo?} — the marked recce photo
  markup       Json? // the on-image marked install-area annotation
  qualityFlags Json? // {blur,lowLight,overexposed,lowAccuracy} — soft, computed at submit (duplicate stays a recce-level flag)

  recce       Recce        @relation(fields: [recceId], references: [id], onDelete: Cascade)
  posmType    PosmType     @relation(fields: [posmTypeId], references: [id])
  installPosm InstallPosm?

  @@unique([recceId, slotNo])
  @@map("recce_posms")
}

/// One installation submission per site (after its recce is APPROVED).
model Installation {
  id            String             @id @default(cuid())
  clientId      String
  siteId        String
  recceId       String             @unique
  submittedById String // VENDOR_FIELD user
  status        InstallationStatus @default(SUBMITTED)
  version       Int                @default(1)

  capturedAt DateTime?
  receivedAt DateTime  @default(now())

  auditedById         String? // AUDITOR
  auditedAt           DateTime?
  rejectionReasonCode RejectReasonCode?
  rejectionReason     String?

  // HO/Admin escalation (owner decision 2026-09-30): on an audit REJECT the row escalates to HO;
  // HO approve → APPROVED (overrides the audit reject), HO reject → REJECTED (terminal).
  hoReviewStatus    HoReviewStatus @default(NONE)
  hoReviewedById    String? // CLIENT_ADMIN / GIFSY_ADMIN
  hoReviewedAt      DateTime?
  hoRejectionReason String?

  // Direct installation flag — set by the future manual direct-install workflow. Default false so
  // the report's "Direct Installation" column reads "No" for the normal recce→install path today.
  isDirect Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  client       Client        @relation(fields: [clientId], references: [id])
  site         Site          @relation(fields: [siteId], references: [id], onDelete: Cascade)
  recce        Recce         @relation(fields: [recceId], references: [id])
  submittedBy  User          @relation("InstallSubmitter", fields: [submittedById], references: [id])
  auditedBy    User?         @relation("InstallAuditor", fields: [auditedById], references: [id])
  hoReviewedBy User?         @relation("InstallHoReviewer", fields: [hoReviewedById], references: [id])
  posms        InstallPosm[]

  @@index([clientId, status])
  @@index([clientId, hoReviewStatus])
  @@map("installations")
}

/// The actual installed-POSM photo, linked 1:1 to the recce POSM it fulfils.
model InstallPosm {
  id                String   @id @default(cuid())
  installationId    String
  reccePosmId       String   @unique
  photo             Json // MediaValue {key, geo?}
  captureLat        Decimal? @db.Decimal(10, 8)
  captureLng        Decimal? @db.Decimal(11, 8)
  geoFenceOk        Boolean?
  distanceFromRecce Decimal? @db.Decimal(10, 2) // recce↔install distance (auditor input)
  beforeAfterDiffOk Boolean? // perceptual-diff: install ≠ recce
  qualityFlags      Json? // {blur, lowLight, overexposed, glare, blank, lowAccuracy}

  installation Installation @relation(fields: [installationId], references: [id], onDelete: Cascade)
  reccePosm    ReccePosm    @relation(fields: [reccePosmId], references: [id])

  @@map("install_posms")
}

/// Content-hash duplicate detection across the tenant (copy of VisibilityImageHash).
model ImageHash {
  id        String   @id @default(cuid())
  clientId  String
  ownerKind String // "RECCE" | "INSTALL" | "MANUAL"
  ownerId   String // the submission id owning the photo
  hash      String // SHA-256 of raw bytes
  createdAt DateTime @default(now())

  // Anti-fraud (money path): exact-byte reuse of a photo within a tenant is a duplicate. A true
  // unique on (clientId, hash) makes ANY reuse collide at the DB regardless of ownerKind, closing
  // the read-then-write cross-submission duplicate race (two concurrent installs reusing one
  // photo can no longer both commit). Distinct photos → distinct SHA-256 → never false-collide;
  // the only legitimate same-hash case (a submission re-recording its OWN photo, e.g. recce
  // resubmit) reuses the SAME (clientId, ownerKind, ownerId) row and is filtered out before the
  // insert. Supersedes the former plain @@index([clientId, hash]) (a unique already indexes it).
  @@unique([clientId, hash])
  @@index([ownerKind, ownerId])
  @@map("image_hashes")
}

// ═════════════════════════════════════════════════════════════════════════════
// MANUAL WORKFLOW — admin-configured ad-hoc tasks (skip the recce/install spine)
// ═════════════════════════════════════════════════════════════════════════════

// A manual task's own lifecycle (accepting submissions vs archived) — distinct from a
// submission's review lifecycle below. The v0 scaffolding conflated both into one enum.
enum ManualTaskState {
  OPEN
  CLOSED
}

// A manual-task submission's review lifecycle — direct admin approval (no ASM/auditor stage).
enum ManualSubmissionStatus {
  SUBMITTED
  APPROVED
  REJECTED
}

/**
 * ManualTask — an ad-hoc, admin-defined task (survey / checklist / photo capture) OUTSIDE the
 * recce→install pipeline. The `formSchema` reuses the trimmed capture form engine
 * (visibility-types: TEXT / CAMERA / GPS_POINT …), so a task can require typed answers, photos
 * (stored media keys), and per-photo geo. `vendorId = null` targets every vendor fleet in the
 * tenant; a value scopes it to one fleet. Direct admin approval — no ASM/auditor.
 */
model ManualTask {
  id          String          @id @default(cuid())
  clientId    String
  title       String
  description String?
  formSchema  Json // reuse the trimmed capture form engine
  vendorId    String? // null = all fleets in the tenant
  dueDate     DateTime? // optional deadline (drives reminder emails)
  status      ManualTaskState @default(OPEN)
  createdById String // admin who defined the task
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  submissions ManualTaskSubmission[]

  @@index([clientId, status])
  @@index([clientId, vendorId])
  @@map("manual_tasks")
}

/**
 * One field-user submission for a ManualTask. `formValues` holds the answers keyed by field id
 * (media fields carry `{key, geo?}` MediaValues). One live submission per (task, submitter); a
 * REJECTED one is re-captured in place (version bumps). `clientId` is denormalized so tenant
 * scoping needs no join. Reviewed directly by an admin.
 */
model ManualTaskSubmission {
  id              String                 @id @default(cuid())
  clientId        String // denormalized for tenant scoping
  taskId          String
  submittedById   String // VENDOR_FIELD user
  vendorId        String? // submitter's fleet at submit time
  formValues      Json
  status          ManualSubmissionStatus @default(SUBMITTED)
  version         Int                    @default(1)
  reviewedById    String? // admin (direct approval)
  reviewedAt      DateTime?
  rejectionReason String? // free-text (arbitrary tasks)
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  task ManualTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([taskId, submittedById])
  @@index([clientId, status])
  @@index([taskId])
  @@map("manual_task_submissions")
}

/**
 * Idempotency ledger for scheduled email digests (Wave 3d). The @@unique([clientId,
 * digestType, forDate]) is the guard: the daily cron INSERTs a row for today before sending,
 * and a P2002 means "already sent today" — so a restart / double-fire never double-emails.
 * `forDate` is date-only (the digest covers one calendar day). `meta` snapshots recipients +
 * the counts that went out (audit). Recipients themselves live in per-tenant Client.settings.
 */
model EmailDigestLog {
  id         String   @id @default(cuid())
  clientId   String
  digestType String // e.g. 'DAILY_DIGEST'
  forDate    DateTime @db.Date // the calendar day covered (idempotency key)
  sentAt     DateTime @default(now())
  meta       Json? // { recipients, counts } snapshot

  @@unique([clientId, digestType, forDate])
  @@index([clientId])
  @@map("email_digest_logs")
}

// Idempotency ledger for the per-ASM pending-recce reminder. One row = "this ASM was reminded for
// this cron tick". `periodKey` is the IST hour bucket ("YYYY-MM-DDTHH"); the cron fires once/hour,
// so concurrent instances of the same tick collide on the unique key and only ONE sends — killing
// the multi-instance duplicate-email race (the per-recce `Recce.lastRemindedAt` is the separate
// across-tick interval throttle). Mirrors EmailDigestLog.
model AsmReminderLog {
  id        String   @id @default(cuid())
  clientId  String
  asmUserId String
  periodKey String // IST hour bucket "YYYY-MM-DDTHH" (idempotency key)
  sentAt    DateTime @default(now())
  itemCount Int // recces included in the reminder (snapshot)

  @@unique([clientId, asmUserId, periodKey])
  @@index([clientId])
  @@map("asm_reminder_logs")
}
