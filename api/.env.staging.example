# ─────────────────────────────────────────────────────────────────────────────
# gifsy-posm API — STAGING environment (Cloud Run service `posm-api-staging`)
#
# PLACEHOLDERS ONLY. This file documents the shape of the env; it is NOT loaded by the
# container. In Cloud Run the values are injected as service env vars:
#   [secret] = bound from Secret Manager (`--set-secrets`)   → never put the real value in git
#   [plain]  = ordinary env var (`--set-env-vars`, via Terraform)
# NEVER commit a real .env / .env.staging. Canonical inventory: docs/plans/DEPLOY-ENV-VARS.md
# ─────────────────────────────────────────────────────────────────────────────

# ── Runtime mode ─────────────────────────────────────────────────────────────
# [plain] Cloud Run runs a production build even for staging. NODE_ENV=production also makes the
# fixed-OTP guard (api/src/common/fixed-otp.ts) DENY by default — staging re-enables it explicitly below.
NODE_ENV=production
# [plain, injected by Cloud Run] Do not set by hand on Cloud Run (default 8080). main.ts reads it.
# PORT=8080

# ── Database ─────────────────────────────────────────────────────────────────
# [secret] Secret Manager: `posm-staging-database-url`. Shape only — real value holds the
# `posm_app` password. Database MUST be named `posm_staging`: the staging fixed-OTP opt-in below is
# honored only when the URL matches /posm_staging (fixed-otp.ts layer 2).
#   Unix-socket form (Cloud SQL connector / --add-cloudsql-instances):
#     postgresql://posm_app:<PASSWORD>@localhost/posm_staging?host=/cloudsql/<PROJECT_ID>:asia-south1:<SQL_INSTANCE>&schema=public
#   Private-IP / Direct VPC egress form:
#     postgresql://posm_app:<PASSWORD>@<PRIVATE_IP>:5432/posm_staging?schema=public
DATABASE_URL="postgresql://posm_app:<PASSWORD>@<PRIVATE_IP>:5432/posm_staging?schema=public"

# ── Auth ─────────────────────────────────────────────────────────────────────
# [secret] Secret Manager: `posm-staging-jwt-secret`. REQUIRED at boot (the api refuses to start
# without it). MUST be IDENTICAL to the staging frontend's JWT_SECRET (the Next proxy verifies tokens).
JWT_SECRET="<from Secret Manager: posm-staging-jwt-secret>"
# [plain] Access-token lifetime (short, so the rolling session slides).
JWT_EXPIRES_IN=60m

# ── OTP — ⚠️⚠️ STAGING ONLY — NEVER COPY THESE TWO LINES TO PRODUCTION ⚠️⚠️ ──
# FIXED_OTP makes EVERY login OTP the constant below (MSG91 is not called) — a universal-login
# backdoor. It is acceptable on staging UAT only. It is honored only when ALL hold:
#   NODE_ENV=production + ALLOW_FIXED_OTP=true + DATABASE_URL matches /posm_staging.
# [plain] (not secrets — deliberate, well-known UAT value)
FIXED_OTP=123456
ALLOW_FIXED_OTP=true

# ── MSG91 (SMS / OTP / WhatsApp / SMTP email) ────────────────────────────────
# [secret] `posm-staging-msg91-auth-key`
MSG91_AUTH_KEY="<from Secret Manager: posm-staging-msg91-auth-key>"
# [secret] `posm-staging-msg91-otp-template-id`
MSG91_OTP_TEMPLATE_ID="<from Secret Manager: posm-staging-msg91-otp-template-id>"
# [plain, optional] WhatsApp integrated number — WhatsApp sends are skipped (logged) if unset.
MSG91_WHATSAPP_NUMBER=""
# [secret] SMTP relay credentials: `posm-staging-msg91-smtp-user` / `posm-staging-msg91-smtp-pass`
MSG91_SMTP_USER="<from Secret Manager: posm-staging-msg91-smtp-user>"
MSG91_SMTP_PASS="<from Secret Manager: posm-staging-msg91-smtp-pass>"
# [plain] SMTP host/port (MSG91 mailer relay).
MSG91_SMTP_HOST=smtp.mailer91.com
MSG91_SMTP_PORT=587
# [plain] From-address for scheduled/transactional reports (must be a MSG91-verified sender).
REPORTS_FROM_EMAIL="<reports@your-verified-domain>"

# ── Media storage (Google Cloud Storage) ─────────────────────────────────────
# [plain] `gcs` in cloud (`local` is dev/compose only).
STORAGE_DRIVER=gcs
# [plain] Staging media bucket (runtime SA `posm-api-staging` has storage.objectAdmin on it).
GCS_BUCKET=posm-staging-files
# [plain] GCP project id (TF var `project_id`). Auth is via the Cloud Run runtime SA (ADC) —
# do NOT set GOOGLE_APPLICATION_CREDENTIALS in cloud.
GCP_PROJECT_ID="<PROJECT_ID>"

# ── HTTP ─────────────────────────────────────────────────────────────────────
# [plain] Comma-separated allowed browser origins = the staging frontend URL(s). No trailing slash.
# (Browser calls are same-origin via the Next proxy, so this is mostly defense-in-depth.)
CORS_ORIGINS="https://<posm-frontend-staging URL or uat host>"

# ── Misc ─────────────────────────────────────────────────────────────────────
# [plain] Kept per the deploy contract. NOTE: current code no longer reads this (PermissionGuard
# always enforces RBAC) — it is a harmless no-op, carried for contract/inventory parity.
RBAC_ENFORCEMENT=false
# [plain] pino level.
LOG_LEVEL=info
